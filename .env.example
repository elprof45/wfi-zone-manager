# ==============================================================================
# ── 1. Application & Serveur ──
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NetPulse Hotspot Manager"

# ── 2. Base de Données PostgreSQL (Drizzle ORM & Better-Auth) ──
DATABASE_URL="postgresql://netpulse_hotspot:netpulse_hotspot@localhost:5434/netpulse_hotspot_db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=netpulse_hotspot
POSTGRES_PASSWORD=netpulse_hotspot
POSTGRES_DB=netpulse_hotspot_db

# ── 3. Clé de Sécurité & Authentification (Better-Auth) ──
# Générer une chaîne aléatoire sécurisée de 32+ caractères
BETTER_AUTH_SECRET="CHANGE_ME_WITH_A_RANDOM_SECRET"
BETTER_AUTH_URL="http://localhost:3000"

# AES-256 key for encrypting MikroTik router passwords (64 hex characters)
ROUTER_CREDENTIALS_KEY=""
MIKROTIK_HEARTBEAT_TOKEN=""

# ── 4. Assistant IA Gemini (Optionnel) ──
GEMINI_API_KEY=""

# ==============================================================================
# ── SECTION B : VARIABLES OPTIONNELLES (OU CONFIGURÉES VIA /setup) ──
# ==============================================================================

# ── Paramètres Régionaux & Alertes ──
DEFAULT_CURRENCY="FCFA"
DEFAULT_TIMEZONE="Africa/Abidjan"
LOW_STOCK_THRESHOLD=15

# ── Passerelle Email : Resend API (Recommandé) ──
# Obtenez votre clé sur https://resend.com
RESEND_API_KEY=""
RESEND_FROM="NetPulse Hotspot <onboarding@resend.dev>"

# ── Passerelle Email : SMTP Traditionnel (Alternative à Resend) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
NOTIFICATION_EMAILS="direction@netpulse.lan, comptabilite@netpulse.lan"

# ── Bot Telegram (Alertes & Commandes Distantes) ──
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# ── Discord (Bot HTTP API & Interactions Endpoint) ──
DISCORD_BOT_TOKEN=""
DISCORD_CHANNEL_ID=""
DISCORD_PUBLIC_KEY=""
DISCORD_APPLICATION_ID=""


# ==============================================================================
# NetPulse Hotspot Manager - Variables d'Environnement (.env.example)
# ==============================================================================

# ── 1. Application & Paramètres Généraux ──
NEXT_PUBLIC_APP_NAME="NetPulse Hotspot Manager"
APP_URL="http://localhost:3000"
DEFAULT_CURRENCY="FCFA"
DEFAULT_TIMEZONE="Africa/Abidjan"
LOW_STOCK_THRESHOLD=15

# ── 2. Intelligence Artificielle (Assistant NetPulse) ──
GEMINI_API_KEY="AIzaSy..."

# ── 3. Base de Données PostgreSQL ──
# Chaîne de connexion standard PostgreSQL (Drizzle ORM & Better-Auth)
DATABASE_URL="postgresql://netpulse_hotspot:netpulse_hotspot@localhost:5434/netpulse_hotspot_db"

# Paramètres Docker Compose PostgreSQL 16
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_USER=netpulse_hotspot
POSTGRES_PASSWORD=netpulse_hotspot
POSTGRES_DB=netpulse_hotspot_db

# ── 4. Authentification (Better-Auth) ──
BETTER_AUTH_SECRET="zazazett546reERMYt5456er4tgerrygy564e'ze6541rz5rezt"
BETTER_AUTH_URL="http://localhost:3000"

# ── 5. Passerelle Email SMTP (Rapports Financiers & Alertes) ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="votre-email@gmail.com"
SMTP_PASS="votre-mot-de-passe-d-application"
SMTP_FROM="NetPulse Hotspot <votre-email@gmail.com>"
NOTIFICATION_EMAILS="direction@netpulse.lan, comptabilite@netpulse.lan"

# ── 6. Bot Telegram ──
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrSTUvwxYZ"
TELEGRAM_CHAT_ID="-1001234567890"

# ── 7. Discord (Webhooks & Bot Interactions) ──
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/..."
DISCORD_BOT_TOKEN="OT..."
DISCORD_PUBLIC_KEY="a1b2c3..."
DISCORD_APPLICATION_ID="123456789012345678"

# ── 8. Slack (Incoming Webhook) ──
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"

# ── 9. WhatsApp (Passerelle Twilio REST API) ──
TWILIO_ACCOUNT_SID="ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_WHATSAPP_TO="+22890123456"

# ── 10. Premier Routeur MikroTik (Valeurs par défaut à l'initialisation) ──
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT=8728
MIKROTIK_CONNECTION_TYPE="socket"
MIKROTIK_USER="admin"
MIKROTIK_PASSWORD=""
MIKROTIK_DNS_NAME="hotspot.wifi"
